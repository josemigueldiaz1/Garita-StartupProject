# Copia este archivo como .env (en la raíz del repo) y pon tu clave después del "=".
# .env está en .gitignore: nunca se sube al repositorio.
DEEPSEEK_API_KEY=

# Tope de gasto en dólares para las llamadas al LLM (pipeline + app). Si se alcanza,
# la app sigue en modo demo con los datos ya procesados.
GARITA_TOPE_USD=3.00
